# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real IDs or write tokens.

NEXT_PUBLIC_LOCALE=hu

# Staging / local: same-origin /en path-prefix (middleware rewrite)
NEXT_PUBLIC_SITE_URL_HU=https://bohemjazz.netlify.app
NEXT_PUBLIC_SITE_URL_EN=https://bohemjazz.netlify.app

# GO-LIVE (Netlify dashboard only — do not commit production secrets here):
# NEXT_PUBLIC_SITE_URL_HU=https://jazzfovaros.hu
# NEXT_PUBLIC_SITE_URL_EN=https://jazzfovaros.hu

# Local dev: localhost soha nem redirectel productionre.
# HU: http://localhost:3000/   EN: http://localhost:3000/en/

# --- Analytics (optional) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GADS_ID=
