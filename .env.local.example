# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real IDs.

# Build locale — set to "hu" or "en" at build time
NEXT_PUBLIC_LOCALE=hu

# Canonical site URLs (no trailing slash)
# Staging: single Netlify site at bohemjazz.netlify.app (HU build).
# EN site does not exist yet — both URLs point to the same staging site for now.
# GO-LIVE: set real production domains in the Netlify dashboard on both sites.
NEXT_PUBLIC_SITE_URL_HU=https://bohemjazz.netlify.app
NEXT_PUBLIC_SITE_URL_EN=https://bohemjazz.netlify.app

# --- Local dev EN testing ---
# When NEXT_PUBLIC_SITE_URL_EN is not set, the EN switch uses a same-origin /en path.
# To test the EN build locally, run a second dev server and set:
# NEXT_PUBLIC_SITE_URL_EN=http://localhost:3003
#
# --- Netlify: runtime switch override without rebuild ---
# Snippet injection (before </body>) on the HU site:
#   <script>window.__PEER_LOCALE_URL__='https://OTHER-LANG-SITE.netlify.app';</script>
# LocaleSwitchAnchor overrides the href at runtime (no redeploy needed).

# --- Analytics (all optional) ---

# Google Tag Manager container ID
# When set, GTM manages GA4 and Ads — leave GA4/Ads vars empty
NEXT_PUBLIC_GTM_ID=

# GA4 Measurement ID (only used if GTM is NOT set)
NEXT_PUBLIC_GA4_ID=

# Google Ads conversion ID (only used if GTM is NOT set)
NEXT_PUBLIC_GADS_ID=
