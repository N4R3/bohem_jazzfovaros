NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# --- Site URL (no trailing slash) ---
# Staging (default): egy Netlify site, /en path-prefix EN verzióhoz
NEXT_PUBLIC_SITE_URL_HU=https://bohemjazz.netlify.app
NEXT_PUBLIC_SITE_URL_EN=https://bohemjazz.netlify.app

# GO-LIVE (Netlify dashboard — staging értékeket felülírja):
# NEXT_PUBLIC_SITE_URL_HU=https://jazzfovaros.hu
# NEXT_PUBLIC_SITE_URL_EN=https://jazzfovaros.hu
# EN = /en/ útvonal ugyanazon a domainen (jazzcapital.hu NEM Netlify custom domain).

# Opcionális build locale (Netlify: hu site = hu, ha külön EN site lenne = en)
# NEXT_PUBLIC_LOCALE=hu

# Opcionális legacy (ha még használod):
# NEXT_PUBLIC_SITE_URL=

SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
