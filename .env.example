NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# --- Site URL (no trailing slash) ---
# Staging (default): egy Netlify site, /en path-prefix EN verzióhoz
NEXT_PUBLIC_SITE_URL_HU=https://bohemjazz.netlify.app
NEXT_PUBLIC_SITE_URL_EN=https://bohemjazz.netlify.app

# GO-LIVE (Netlify dashboard — staging értékeket felülírja):
# NEXT_PUBLIC_SITE_URL_HU=https://jazzfovaros.hu
# NEXT_PUBLIC_SITE_URL_EN=https://jazzfovaros.hu
# EN = /en/ útvonal ugyanazon a domainen (jazzcapital.hu NEM Netlify custom domain).

# Opcionális build locale (Netlify: hu site = hu, ha külön EN site lenne = en)
# NEXT_PUBLIC_LOCALE=hu

# Opcionális legacy (ha még használod):
# NEXT_PUBLIC_SITE_URL=

SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID (public, safe to commit)
NEXT_PUBLIC_GA4_ID=G-Y9BMR7XZK6
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GADS_ID=

# --- Használati monitoring (Netlify Function/Edge felhasználás követése) ---
# A Netlify log retention ~24 óra, ezért a route-onkénti napi számlálókat
# aggregáltan a Netlify Blobs tárolóba írjuk (nincs benne személyes adat).
#
# Kötelező a riport lekérdezéséhez — enélkül a /api/usage/ végpont 503-at ad,
# tehát véletlenül sem lehet publikusan elérhető. Generálás:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# USAGE_STATS_TOKEN=
#
# Lekérdezés:
#   curl -H "Authorization: Bearer $USAGE_STATS_TOKEN" \
#        "https://jazzfovaros.hu/api/usage/?days=14"
#
# Kikapcsolás (alapból mindkettő be van kapcsolva):
# USAGE_METRICS=0   # tartós napi számlálók (Netlify Blobs)
# USAGE_LOG=0       # kérésenkénti [usage] sor az edge logban
